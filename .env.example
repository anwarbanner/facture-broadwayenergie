APP_NAME="ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Simple mode (short menu, one-click cash-in on quotes). false = full ERP menu.
SIMPLE_MODE=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Company identity (see docs/PERSONNALISATION.md). Empty values are not printed.
COMPANY_NAME="Mon Entreprise"
# Logo under public/, e.g. assets/img/brand/logo.png. Empty = badge with the initials of COMPANY_NAME.
COMPANY_LOGO_PATH=""
COMPANY_TAGLINE="Gestion commerciale"
COMPANY_PHONE=""
COMPANY_EMAIL=""
COMPANY_ADDRESS=""
COMPANY_CITY=""
COMPANY_COUNTRY=""
# Legal identifiers as free text, any country (e.g. "SIRET 123 456 789 00012 | TVA FR12345678901").
COMPANY_LEGAL_IDS=""
# Optional Moroccan identifiers.
COMPANY_ICE=""
COMPANY_RC=""
COMPANY_IF=""
COMPANY_PATENTE=""

# Legal form printed next to the logo (e.g. SARL), business lines top-right of documents (| = new line)
COMPANY_LEGAL_FORM=""
COMPANY_SLOGAN=""
COMPANY_COLOR_PRIMARY="#0061A3"
COMPANY_COLOR_ACCENT="#E91E25"
# Optional images under public/: pale watermark behind documents, square browser-tab icon
COMPANY_WATERMARK_PATH=""
COMPANY_FAVICON_PATH=""

# --- Defaults proposed on new documents
DEFAULT_CURRENCY="MAD"
DEFAULT_VAT_RATE=20

# Debug bar (queries, timings) at the bottom of every page: heavy, keep false unless debugging.
DEBUGBAR_ENABLED=false

# Accounting entries export (Comptabilite > Ecritures comptables) - Moroccan chart of accounts by default
ACCOUNTING_JOURNAL_SALES=VT
ACCOUNTING_JOURNAL_PURCHASES=HA
ACCOUNTING_JOURNAL_BANK=BQ
ACCOUNTING_JOURNAL_CASH=CA
ACCOUNTING_ACCOUNT_CLIENTS=3421
ACCOUNTING_ACCOUNT_SUPPLIERS=4411
ACCOUNTING_ACCOUNT_SALES=7111
ACCOUNTING_ACCOUNT_PURCHASES=6111
ACCOUNTING_ACCOUNT_VAT_COLLECTED=4455
ACCOUNTING_ACCOUNT_VAT_DEDUCTIBLE=3455
ACCOUNTING_ACCOUNT_BANK=5141
ACCOUNTING_ACCOUNT_CASH=5161
